#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ТекстСообщенияПриОтказеИспользования() Экспорт
	Результат = "";
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		Результат = НСтр("ru = 'Обработка не предназначена для использования в файловой информационной базе.'");
	ИначеЕсли Не РаботаСФайловымАрхивомСервер.ДоступныИзмененияВСпособахХраненияФайлов() Тогда
		Результат = НСтр("ru = 'Обработка не предназначена для использования на версиях платформы 1С:Предприятие ниже 8.3.26.'");
	ИначеЕсли ОбщегоНазначения.РазделениеВключено() Тогда
		Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
			Результат = НСтр("ru = 'Обработка не предназначена для использования в разделенном сеансе.'");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти 

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
