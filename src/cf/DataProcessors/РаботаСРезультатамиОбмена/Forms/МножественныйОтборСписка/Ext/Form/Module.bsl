#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.ТипПеречисления = Неопределено
		И Параметры.ДоступныеЗначения = Неопределено Тогда

		ТекстСообщения = НСтр("ru = 'В форму не переданы доступные значения для выбора.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
		Возврат;
			
	КонецЕсли;

	Если ПустаяСтрока(Параметры.Заголовок) Тогда
		Заголовок = НСтр("ru = 'Выбранные значения'");
	Иначе
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ТипПеречисления) = Тип("Тип") Тогда
		
		МетаданныеПеречисления = Метаданные.НайтиПоТипу(Параметры.ТипПеречисления);
		
		Если Метаданные.НайтиПоТипу(Параметры.ТипПеречисления) = Неопределено Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Для Каждого ЗначениеПеречисленияМетаданные Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
			
			ЗначениеПеречисления = Перечисления[МетаданныеПеречисления.Имя][ЗначениеПеречисленияМетаданные.Имя];
			
			Если Параметры.ДоступныеЗначения <> Неопределено
				И Параметры.ДоступныеЗначения.Количество() > 0 Тогда
				
				Если Параметры.ДоступныеЗначения.Найти(ЗначениеПеречисления) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			ЭлементСписка = Список.Добавить();
			
			ЭлементСписка.Значение      = ЗначениеПеречисления;
			
			Если Параметры.ПереопределенныеПредставленияЗначенийПеречисления = Неопределено Тогда
				
				ЭлементСписка.Представление = ЗначениеПеречисленияМетаданные.Синоним;
				
			Иначе
				
				ПереопределенноеПредставление =  Параметры.ПереопределенныеПредставленияЗначенийПеречисления.Получить(ЗначениеПеречисления);
				
				Если ПереопределенноеПредставление <> Неопределено Тогда
					
					ЭлементСписка.Представление = ПереопределенноеПредставление;
					
				Иначе
					
					ЭлементСписка.Представление = ЗначениеПеречисленияМетаданные.Синоним;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Параметры.СписокОтбор.НайтиПоЗначению(ЭлементСписка.Значение) <> Неопределено Тогда
				
				ЭлементСписка.Пометка = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Если Параметры.ДоступныеЗначения.Количество() = 0 Тогда 
			Возврат;
		КонецЕсли;
		
		Для Каждого ДоступноеЗначение Из Параметры.ДоступныеЗначения Цикл
			
			ЭлементСписка = Список.Добавить();
			
			ЭлементСписка.Значение      = ДоступноеЗначение.Значение;
			ЭлементСписка.Представление = ДоступноеЗначение.Представление;
			
			Если Параметры.СписокОтбор.НайтиПоЗначению(ЭлементСписка.Значение) <> Неопределено Тогда
				
				ЭлементСписка.Пометка = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ВыбранныеЗначения = Новый СписокЗначений;
	
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			ВыбранныеЗначения.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(ВыбранныеЗначения);
	
КонецПроцедуры

#КонецОбласти