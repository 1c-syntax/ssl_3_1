#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработатьПереданныеПараметры();
	
	ЗаполнитьДанныеФормы();
	
	УправлениеДоступностью(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	ЗаписатьИзменения();
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	ЗаписатьИзменения();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъектВИсточнике(Команда)
	
	Если ЗначениеЗаполнено(ВнешняяСсылкаНаОбъект) Тогда
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ВнешняяСсылкаНаОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияФормы 

&НаСервере
Процедура ОбработатьПереданныеПараметры()
	
	ПолученныйОбъект   = Параметры.ПолученныйОбъект;
	ПравилоКонвертации = Параметры.ПравилоКонвертации;
	УзелПланаОбмена    = Параметры.УзелИнформационнойБазы;
	ОбъектФормата      = Параметры.ОбъектФормата;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФормы()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПрочитанныеДанныеСообщенийОбмена.СодержимоеЗаписи           КАК СодержимоеЗаписи,
	|	ПрочитанныеДанныеСообщенийОбмена.ПространствоИменURI        КАК ПространствоИменURI,
	|	ПрочитанныеДанныеСообщенийОбмена.ОбъектФормата              КАК ОбъектФормата,
	|	ПрочитанныеДанныеСообщенийОбмена.ДатаДобавления             КАК ДатаДобавления,
	|	ОбъектыКЗагрузке.ВнешняяСсылкаНаОбъект                      КАК ВнешняяСсылкаНаОбъект
	|ИЗ
	|	РегистрСведений.ОбъектыКЗагрузке КАК ОбъектыКЗагрузке
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПрочитанныеДанныеСообщенийОбмена КАК ПрочитанныеДанныеСообщенийОбмена
	|		ПО (ОбъектыКЗагрузке.ПолученныйОбъект = ПрочитанныеДанныеСообщенийОбмена.ПолученныйОбъект
	|				И ПрочитанныеДанныеСообщенийОбмена.УзелПланаОбмена = &УзелПланаОбмена
	|				И ОбъектыКЗагрузке.ОбъектФормата = ПрочитанныеДанныеСообщенийОбмена.ОбъектФормата)
	|ГДЕ
	|	ОбъектыКЗагрузке.ПолученныйОбъект = &ПолученныйОбъект
	|	И ОбъектыКЗагрузке.ПравилоКонвертации = &ПравилоКонвертации
	|	И ОбъектыКЗагрузке.ОбъектФормата = &ОбъектФормата";
	
	Запрос.УстановитьПараметр("ПолученныйОбъект",   ПолученныйОбъект);
	Запрос.УстановитьПараметр("ОбъектФормата",      ОбъектФормата);
	Запрос.УстановитьПараметр("ПравилоКонвертации", ПравилоКонвертации);
	Запрос.УстановитьПараметр("УзелПланаОбмена",    УзелПланаОбмена);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	СодержимоеЗаписи       = Выборка.СодержимоеЗаписи;
	ДатаПолучения          = Выборка.ДатаДобавления;
	ПространствоИменURI    = Выборка.ПространствоИменURI;
	ВнешняяСсылкаНаОбъект  = Выборка.ВнешняяСсылкаНаОбъект; 
	
КонецПроцедуры

#КонецОбласти

#Область ЗаписьИзменений

&НаСервере
Процедура ЗаписатьИзменения()

	ДанныеЗаписи = РегистрыСведений.ПрочитанныеДанныеСообщенийОбмена.НовыйДанныеИзмененияЗаписиРегистра();
	
	ДанныеЗаписи.ПолученныйОбъект = ПолученныйОбъект;
	ДанныеЗаписи.УзелПланаОбмена  = УзелПланаОбмена;
	ДанныеЗаписи.ОбъектФормата    = ОбъектФормата;
	
	ДанныеЗаписи.СодержимоеЗаписи = СодержимоеЗаписи;
	
	РегистрыСведений.ПрочитанныеДанныеСообщенийОбмена.ИзменитьЗаписьРегистра(ДанныеЗаписи);
	
КонецПроцедуры

#КонецОбласти

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностью(Форма)

	ЭлементыФормы = Форма.Элементы;
	
	ЭлементыФормы.ФормаОткрытьОбъектВИсточнике.Видимость = ЗначениеЗаполнено(Форма.ВнешняяСсылкаНаОбъект);

КонецПроцедуры

#КонецОбласти