				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ОбъектыКЗагрузке.ПолученныйОбъект                                                                                      КАК ОбъектКПолучению,
	ОбъектыКЗагрузке.ОбъектМетаданных                                                                                      КАК ТипОбъекта,
	ОбъектыКЗагрузке.ОбъектФормата                                                                                         КАК ОбъектФормата,
	ВЫБОР
		КОГДА ИдентификаторыОбъектовМетаданных.ПорядокКоллекции ЕСТЬ NULL
			ТОГДА 0
		КОГДА ИдентификаторыОбъектовМетаданных.ПорядокКоллекции = 4
			ТОГДА 4
		КОГДА ИдентификаторыОбъектовМетаданных.ПорядокКоллекции = 5
			ТОГДА 8
		ИНАЧЕ 0
	КОНЕЦ                                                                                                                   КАК ИдентификаторКартинки,
	ОбъектыКЗагрузке.ВнешняяСсылкаНаОбъект                                                                                  КАК ВнешняяСсылкаНаОбъект,
	ОбъектыКЗагрузке.СсылкаНаОбъект                                                                                         КАК СоответствиеВИБ,
	ЕСТЬNULL(ИдентификаторыОбъектовМетаданных.ПолноеИмя, "")                                                                КАК ПолноеИмяОбъектаМетаданных,
	ЕСТЬNULL(КоличествоБлокируемыхОбъектовКЗагрузке.Количество, 0)                                                          КАК КоличествоБлокирует,
	ЕСТЬNULL(КоличествоБлокируемыхОбъектовКЗагрузке.МинимальнаяДатаУстановкиПричиныДобавления, ДАТАВРЕМЯ(1, 1, 1, 1, 1, 1)) КАК ДатаВозникновения,
	ОбъектыКЗагрузке.ДатаОтправкиЗапросаНаВыгрузку                                                                          КАК ДатаОтправкиЗапросаНаВыгрузку
ИЗ
	РегистрСведений.ОбъектыКЗагрузке КАК ОбъектыКЗагрузке
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
			ПО (ОбъектыКЗагрузке.ОбъектМетаданных = ИдентификаторыОбъектовМетаданных.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КоличествоБлокируемыхОбъектовКЗагрузке КАК КоличествоБлокируемыхОбъектовКЗагрузке
			ПО ОбъектыКЗагрузке.ПолученныйОбъект = КоличествоБлокируемыхОбъектовКЗагрузке.ОбъектКПолучению
			И ОбъектыКЗагрузке.ОбъектФормата     = КоличествоБлокируемыхОбъектовКЗагрузке.ОбъектФормата
			И КоличествоБлокируемыхОбъектовКЗагрузке.УзелПланаОбмена = ОбъектыКЗагрузке.УзелПланаОбмена
ГДЕ
	ОбъектыКЗагрузке.ПричинаДобавления = ЗНАЧЕНИЕ(Перечисление.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОжидаетсяПолучениеЭтогоОбъекта)
	И ОбъектыКЗагрузке.УзелПланаОбмена = &amp;УзелПланаОбмена
{ГДЕ
	((ЕСТЬNULL(КоличествоБлокируемыхОбъектовКЗагрузке.МинимальнаяДатаУстановкиПричиныДобавления, ДАТАВРЕМЯ(1, 1, 1, 1, 1, 1)) &gt;= &amp;НачалоПериода
			ИЛИ &amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1))
			И (ЕСТЬNULL(КоличествоБлокируемыхОбъектовКЗагрузке.МинимальнаяДатаУстановкиПричиныДобавления, ДАТАВРЕМЯ(1, 1, 1, 1, 1, 1)) &lt;= &amp;КонецПериода
				ИЛИ &amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)))}

</QueryText>
