	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ИзменениеОтключенияОграничений.ЕстьПользователи) КАК ЕстьПользователи,
	|	МАКСИМУМ(ИзменениеОтключенияОграничений.ЕстьВнешниеПользователи) КАК ЕстьВнешниеПользователи
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		НаличиеПользователейГруппДоступа.ЕстьПользователи КАК ЕстьПользователи,
	|		ЛОЖЬ КАК ЕстьВнешниеПользователи
	|	ИЗ
	|		ГруппыДоступаСОтключеннымОграничениемДляПользователей КАК ГруппыДоступаСОтключеннымОграничением
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ НаличиеПользователейГруппДоступа КАК НаличиеПользователейГруппДоступа
	|			ПО (НаличиеПользователейГруппДоступа.ГруппаДоступа = ГруппыДоступаСОтключеннымОграничением.ГруппаДоступа)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЛОЖЬ,
	|		НаличиеПользователейГруппДоступа.ЕстьВнешниеПользователи
	|	ИЗ
	|		ГруппыДоступаСОтключеннымОграничениемДляВнешнихПользователей КАК ГруппыДоступаСОтключеннымОграничением
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ НаличиеПользователейГруппДоступа КАК НаличиеПользователейГруппДоступа
	|			ПО (НаличиеПользователейГруппДоступа.ГруппаДоступа = ГруппыДоступаСОтключеннымОграничением.ГруппаДоступа)) КАК ИзменениеОтключенияОграничений
	|
	|ИМЕЮЩИЕ
	|	НЕ МАКСИМУМ(ИзменениеОтключенияОграничений.ЕстьПользователи) ЕСТЬ NULL";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ПраваРолейРасширений", УправлениеДоступомСлужебный.ПраваРолейРасширений());
	Запрос.УстановитьПараметр("ТаблицыСВозможноОтключеннымОграничением",
		УправлениеДоступомСлужебный.ТаблицыСВозможноОтключеннымОграничением());
	Запрос.УстановитьПараметр("ПустойУИД", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	УправлениеДоступомСлужебный.УстановитьУсловиеОтбораВЗапросе(Запрос, Таблицы, "Таблицы",
		"&УсловиеОтбораТаблиц1:ПраваРолей.ОбъектМетаданных
		|&УсловиеОтбораТаблиц2:СтарыеДанные.Таблица
		|&УсловиеОтбораТаблиц3:ТаблицыСВозможноОтключеннымОграничением.Таблица");
	
	УправлениеДоступомСлужебный.УстановитьУсловиеОтбораВЗапросе(Запрос, ГруппыДоступа, "ГруппыДоступа",
		"&УсловиеОтбораГруппДоступа1:ГруппыДоступа.Ссылка
		|&УсловиеОтбораГруппДоступа2:СтарыеДанные.ГруппаДоступа");
		
	Блокировка = Новый БлокировкаДанных;
	Если ГруппыДоступа = Неопределено Тогда
		Блокировка.Добавить("РегистрСведений.ТаблицыГруппДоступа");
	Иначе
		ЗначенияБлокировки = ?(ТипЗнч(ГруппыДоступа) = Тип("Массив"), ГруппыДоступа,
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ГруппыДоступа));
		Для Каждого ЗначениеБлокировки Из ЗначенияБлокировки Цикл
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТаблицыГруппДоступа");
			ЭлементБлокировки.УстановитьЗначение("ГруппаДоступа", ЗначениеБлокировки);
		КонецЦикла;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Результаты = Запрос.ВыполнитьПакет();
		Если Не Результаты[0].Пустой() Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Таблица.Установить(Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка());
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЕстьИзменения = Истина;
		КонецЕсли;
		Если Не Результаты[1].Пустой() Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Таблица.Установить(Справочники.ИдентификаторыОбъектовРасширений.ПустаяСсылка());
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЕстьИзменения = Истина;
		КонецЕсли;
		Если Не Результаты[2].Пустой() Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Таблица.Установить(Неопределено);
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЕстьИзменения = Истина;
		КонецЕсли;
		Если Не Результаты[3].Пустой() Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ГруппаДоступа.Установить(Справочники.ГруппыДоступа.ПустаяСсылка());
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЕстьИзменения = Истина;
		КонецЕсли;
		
		Если ГруппыДоступа <> Неопределено
		   И Таблицы        = Неопределено Тогда
			
			ИзмеренияОтбора = "ГруппаДоступа";
		Иначе
			ИзмеренияОтбора = Неопределено;
		КонецЕсли;
		
		Данные = Новый Структура;
		Данные.Вставить("МенеджерРегистра",      РегистрыСведений.ТаблицыГруппДоступа);
		Данные.Вставить("ИзмененияСоставаСтрок", Результаты[15].Выгрузить());
		Данные.Вставить("ИзмеренияОтбора",       ИзмеренияОтбора);
		
		ЕстьТекущиеИзменения = Ложь;
		УправлениеДоступомСлужебный.ОбновитьРегистрСведений(Данные, ЕстьТекущиеИзменения);
		Если ЕстьТекущиеИзменения Тогда
			ЕстьИзменения = Истина;
			ИзменениеТаблиц = Результаты[16].Выгрузить().ВыгрузитьКолонку("Таблица");
			РегистрыСведений.ИспользуемыеВидыДоступаПоТаблицам.ОбновитьДанныеРегистра(ИзменениеТаблиц);
		КонецЕсли;
		
		Если ЕстьТекущиеИзменения
		   И УправлениеДоступомСлужебный.ОграничиватьДоступНаУровнеЗаписейУниверсально() Тогда
			
			ИзменениеПравНаТаблицы = Новый Структура;
			ИзменениеПравНаТаблицы.Вставить("ДляПользователей",
				Результаты[18].Выгрузить());
			ИзменениеПравНаТаблицы.Вставить("ДляВнешнихПользователей",
				Результаты[19].Выгрузить());
			
			ИзменениеОтключенияЧтения = Новый Структура;
			ИзменениеОтключенияЧтения.Вставить("ИдентификаторыПользователейИБ",
				Результаты[22].Выгрузить().ВыгрузитьКолонку("ИдентификаторПользователяИБ"));
			ИзменениеОтключенияЧтения.Вставить("ИдентификаторыВнешнихПользователейИБ",
				Результаты[23].Выгрузить().ВыгрузитьКолонку("ИдентификаторПользователяИБ"));
			
			УправлениеДоступомСлужебный.ЗапланироватьОбновлениеДоступаПриИзмененииТаблицГруппДоступа(
				ИзменениеПравНаТаблицы,
				ИзменениеОтключенияЧтения,
				Результаты[26].Выгрузить());
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

