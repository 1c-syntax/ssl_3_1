#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура ДобавитьЗапись(СтруктураЗаписи) Экспорт
	
	ОбменДаннымиСлужебный.ДобавитьЗаписьВРегистрСведений(СтруктураЗаписи, "СообщенияОбменаДаннымиОбластейДанных");
	
КонецПроцедуры

Процедура УдалитьЗапись(СтруктураЗаписи) Экспорт
	
	Запись = СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, СтруктураЗаписи);
	Запись.Удалить();
	
КонецПроцедуры

// Очистка старых файлов сообщений обмена для указанного узла и действия.
//
// Параметры:
//  УзелОбмена - ПланОбменаСсылка - узел обмена, для которого нужно удалить старые файлы.
//  Действие   - ПеречислениеСсылка.ДействияПриОбмене - действие при обмене (выгрузка или загрузка).
//
Процедура УдалитьСтарыеФайлыСообщенияОбмена(Знач УзелОбмена, Знач Действие) Экспорт

	Если УзелОбмена = Неопределено Или Действие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СообщенияОбменаДанными.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	СообщенияОбменаДанными.ИмяФайлаСообщения КАК ИмяФайла
	|ИЗ
	|	РегистрСведений.СообщенияОбменаДаннымиОбластейДанных КАК СообщенияОбменаДанными
	|ГДЕ
	|	СообщенияОбменаДанными.УзелОбмена = &УзелОбмена
	|	И СообщенияОбменаДанными.Действие = &Действие";

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("УзелОбмена", УзелОбмена);
	Запрос.УстановитьПараметр("Действие", Действие);
	Запрос.Текст = ТекстЗапроса;

	РезультатЗапроса = Запрос.Выполнить();

	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл

			Попытка
				УдалитьФайлы(Выборка.ИмяФайла);
			Исключение
				// Игнорируем ошибки удаления файлов, так как они могут быть уже удалены
				Продолжить;
			КонецПопытки;

			СтруктураЗаписи = Новый Структура;
			СтруктураЗаписи.Вставить("ИдентификаторСообщения", Выборка.ИдентификаторСообщения);

			УдалитьЗапись(СтруктураЗаписи);

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецЕсли