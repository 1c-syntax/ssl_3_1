&НаСервереБезКонтекста
Функция ПредставлениеСпискаМаксимальнойДлины(СущностьСтрокой, СтрокиСписка, МаксимальнаяДлинаСтроки)
	
	СкрытыхОтборов = 0;
	ТекстВарианта = СтрСоединить(СтрокиСписка, ", ");
	
	Пока СтрДлина(ТекстВарианта) >= МаксимальнаяДлинаСтроки Цикл
		
		КоличествоОтборов = СтрокиСписка.Количество();
		СкрытыхОтборов    = СкрытыхОтборов + 1; 
		
		СтрокиСписка.Удалить(КоличествоОтборов-1);
		
		СклонениеОтборовПоЧислу = ПолучитьСклоненияСтрокиПоЧислу(СущностьСтрокой,СкрытыхОтборов,,"L=ru_RU; ЧС=Количественное","ПД=Винительный; ПЧ=Число");
		ТекстВарианта = СтрСоединить(СтрокиСписка, ", ") + " " + СтрШаблон(НСтр("ru = 'и еще %1'"), СклонениеОтборовПоЧислу[0]);
		
	КонецЦикла;
	
	Возврат ТекстВарианта;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОпределитьДоступностьКомандыПодтверждениеЗагрузки(Форма)
	
	ЭлементыФормы = Форма.Элементы;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("ЗначенияУстановленыАвтоматически", Истина);
	
	ЕстьЧтоПодтверждать = Форма.ДействияПриПолучении.НайтиСтроки(ПараметрыПоиска).Количество() > 0;
	
	ЭлементыФормы.ПодтвердитьНастройкиЗагрузки.Видимость                                    = ЕстьЧтоПодтверждать;
	ЭлементыФормы.ДействияПриПолученииКонтекстноеМенюПодтвердитьНастройкиЗагрузки.Видимость = ЕстьЧтоПодтверждать;
	ЭлементыФормы.ДействияПриПолученииЗначенияУстановленыАвтоматически.Видимость            = ЕстьЧтоПодтверждать;

КонецПроцедуры

&НаСервере
Функция ИндексыКартинокТиповОбъектовМетаданных(ИмяТипаМетаданных)
	
	Если ИмяТипаМетаданных = "Константы" Тогда
		
		Возврат 1;
		
	ИначеЕсли ИмяТипаМетаданных = "Справочники" Тогда
		
		Возврат 3;
	
	ИначеЕсли ИмяТипаМетаданных = "Документы" Тогда
		
		Возврат 7;

	ИначеЕсли ИмяТипаМетаданных = "ПланыВидовХарактеристик" Тогда
		
		Возврат 9;
		
	ИначеЕсли ИмяТипаМетаданных = "РегистрыСведений" Тогда
		
		Возврат 15;

	ИначеЕсли ИмяТипаМетаданных = "РегистрыНакопления" Тогда
		
		Возврат 17;

	ИначеЕсли ИмяТипаМетаданных = "РегистрыБухгалтерии" Тогда
		
		Возврат 19;
		
	ИначеЕсли ИмяТипаМетаданных = "РегистрыРасчета" Тогда
		
		Возврат 21;
		
	КонецЕсли;
	
КонецФункции

