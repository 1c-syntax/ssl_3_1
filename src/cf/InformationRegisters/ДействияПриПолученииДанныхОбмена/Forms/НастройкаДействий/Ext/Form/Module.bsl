#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ИнициализироватьФорму();
	
	ОбработатьПереданныеПараметры(Параметры, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УстановитьОтборыВСписке(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если НеЗагружатьНастройкиОтбораИзНастроек Тогда
		
		НастройкиКУдалению = Новый Массив;
		ИменаРеквизитовОтбора = ИменаРеквизитовОтбора();
		
		Для Каждого КлючИЗначение Из Настройки Цикл
			
			Если ИменаРеквизитовОтбора.Найти(КлючИЗначение.Ключ) <> Неопределено Тогда
				
				НастройкиКУдалению.Добавить(КлючИЗначение.Ключ);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого НастройкаКУдалению Из НастройкиКУдалению Цикл
			
			Настройки.Удалить(НастройкаКУдалению)
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОтборПоТипамНастройки = Настройки.Получить("ОтборПоТипам"); 
	
	Если ОтборПоТипамНастройки <> Неопределено Тогда
		
		Настройки.Удалить("ОтборПоТипам");
		
		Для Каждого СтрокаОтбора Из ОтборПоТипам Цикл
			
			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("ТипМетаданных", СтрокаОтбора.ТипМетаданных);
			
			НайденныеСтроки = ОтборПоТипамНастройки.НайтиСтроки(ПараметрыПоиска);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				СтрокаОтбора.Выбран = НайденныеСтроки[0].Выбран;
				
			Иначе
				
				СтрокаОтбора.Выбран = Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

