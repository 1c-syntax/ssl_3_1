&НаКлиенте
Процедура ДействияПриПолученииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДействияПриПолученииИндексКартинкиОбъектМетаданных"
		Или Поле.Имя = "ДействияПриПолученииСиноним"
		Или Поле.Имя = "ДействияПриПолученииЗначенияУстановленыАвтоматически"
		Или Поле.Имя = "ДействияПриПолученииБезСоответствияВИБ" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОткрытьФормуИзмененияЗаписи();
		
	КонецЕсли;
	
