#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

//@skip-check data-exchange-load
Процедура ПередЗаписью(Отказ, Замещение)
	
	КоличествоЗаписей = Количество();
	
	Для Сч = 1 По КоличествоЗаписей Цикл
		
		Индекс = КоличествоЗаписей - Сч;
		Если Не ЗначениеЗаполнено(ЭтотОбъект[Индекс].Ссылка) Тогда
			Удалить(Индекс);
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект[Индекс].Основной Тогда
			
			ПризнакОсновной(ЭтотОбъект[Индекс]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДополнительныеСвойства.Свойство("НеОпределятьИзменениеОбъектыБлокирующиеЗагрузку")
		И ДополнительныеСвойства.НеОпределятьИзменениеОбъектыБлокирующиеЗагрузку Тогда
		Возврат;
	Иначе
		ДополнительныеСвойства.Вставить("ДанныеДляОпределенияИзменений", ДанныеДляОпределенияИзменений());
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)
	
	Если ДополнительныеСвойства.Свойство("НеОпределятьИзменениеОбъектыБлокирующиеЗагрузку")
		И ДополнительныеСвойства.НеОпределятьИзменениеОбъектыБлокирующиеЗагрузку Тогда
		Возврат;
	Иначе
		ПроверитьБлокирующиеОбъектыЕслиНеобходимо(ДополнительныеСвойства);
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляОпределенияИзменений()
	
	Возврат РаботаСРезультатамиОбмена.ТаблицаЗаписейПоОтборуНабораЗаписей(Отбор, "ПубличныеИдентификаторыСинхронизируемыхОбъектов", "Идентификатор, УзелИнформационнойБазы");
	
КонецФункции

Процедура ПроверитьБлокирующиеОбъектыЕслиНеобходимо(ДанныеДляПроверки)
	
	ТаблицаСтарыхЗаписей = ДанныеДляПроверки.ДанныеДляОпределенияИзменений;
	
	КлючОбрабатывающегоЗадания = Неопределено;
	Если ДанныеДляПроверки.Свойство("КлючОбрабатывающегоЗадания") 
		И Не ПустаяСтрока(ДанныеДляПроверки.КлючОбрабатывающегоЗадания) Тогда
		
		КлючОбрабатывающегоЗадания = ДанныеДляПроверки.КлючОбрабатывающегоЗадания;
		
	КонецЕсли;
	
	Если ТаблицаСтарыхЗаписей = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекстУсловия = РаботаСРезультатамиОбмена.УсловиеЗапросаПоОтборуНабораЗаписей(Запрос, Отбор);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТаблицаСтарыхЗаписей.Идентификатор          КАК Идентификатор,
	|	ТаблицаСтарыхЗаписей.УзелИнформационнойБазы КАК УзелИнформационнойБазы
	|ПОМЕСТИТЬ СтарыйНабор
	|ИЗ
	|	&ТаблицаСтарыхЗаписей КАК ТаблицаСтарыхЗаписей
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРегистра.Идентификатор          КАК Идентификатор,
	|	ТаблицаРегистра.Идентификатор          КАК ОбъектФормата,
	|	ТаблицаРегистра.УзелИнформационнойБазы КАК УзелИнформационнойБазы
	|ПОМЕСТИТЬ НовыйНабор
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ТаблицаРегистра
	|ГДЕ
	|	&УсловиеЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НовыйНабор.Идентификатор          КАК Идентификатор,
	|	НовыйНабор.ОбъектФормата          КАК ОбъектФормата,
	|	НовыйНабор.УзелИнформационнойБазы КАК УзелИнформационнойБазы
	|ИЗ
	|	НовыйНабор КАК НовыйНабор
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтарыйНабор КАК СтарыйНабор
	|		ПО НовыйНабор.Идентификатор = СтарыйНабор.Идентификатор
	|			И НовыйНабор.УзелИнформационнойБазы = СтарыйНабор.УзелИнформационнойБазы
	|ГДЕ
	|	СтарыйНабор.Идентификатор ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("ТаблицаСтарыхЗаписей", ТаблицаСтарыхЗаписей);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеЗапроса", ТекстУсловия);
	
	ТаблицаЗаписейКПроверке = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписейКПроверке.Количество() > 0 Тогда
		РегистрыСведений.ОбъектыБлокирующиеЗагрузку.ОбработатьНовыеУстановленныеСоответствия(ТаблицаЗаписейКПроверке, КлючОбрабатывающегоЗадания);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПризнакОсновной(ПроверяемаяЗапись)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Идентификатор", ПроверяемаяЗапись.Идентификатор);
	Запрос.УстановитьПараметр("Ссылка", ПроверяемаяЗапись.Ссылка);
	Запрос.УстановитьПараметр("УзелИнформационнойБазы", ПроверяемаяЗапись.УзелИнформационнойБазы);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПИСО.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
	|ГДЕ
	|	ПИСО.Идентификатор <> &Идентификатор
	|	И ПИСО.УзелИнформационнойБазы = &УзелИнформационнойБазы
	|	И ПИСО.Ссылка = &Ссылка
	|	И ПИСО.Основной = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		
		ПроверяемаяЗапись.Основной = ЛОЖЬ;
		
		ТекстСобытие = ОбменДаннымиСервер.СобытиеЖурналаРегистрацииОбменДанными();
		ТекстРасшифровка = НСтр("ru ='Запись публичного идентификатора'", ОбщегоНазначения.КодОсновногоЯзыка());
		СобытиеЖурналаРегистрации = СокрЛП(ТекстСобытие) + "." + СокрЛП(ТекстРасшифровка);
		
		ОбъектМетаданных = Метаданные.РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов;
		ШаблонПредупреждения = НСтр("ru ='Неудачная попытка установить основной идентификатор [%1]
		|для ссылки [%2]
		|по настройке обмена [%3],
		|т.к. основной идентификатора уже назначен [%4].'", ОбщегоНазначения.КодОсновногоЯзыка());
		
		ТекстПредупреждения = СтрШаблон(ШаблонПредупреждения, ПроверяемаяЗапись.Идентификатор, 
			ПроверяемаяЗапись.Ссылка, ПроверяемаяЗапись.УзелИнформационнойБазы, Выборка.Идентификатор);
		
		ЗаписьЖурналаРегистрации(СобытиеЖурналаРегистрации, УровеньЖурналаРегистрации.Предупреждение, ОбъектМетаданных, , ТекстПредупреждения);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли


