<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.v8.1c.ru/ssl/oauth2_mail">
	<import namespace="http://v8.1c.ru/8.1/data/core"/>
	<import namespace="http://www.1c.ru/SaaS/Messages"/>
	<objectType xmlns:d2p1="http://www.1c.ru/SaaS/Messages" name="CallBack" base="d2p1:ZoneBody">
		<property name="code" type="xs:string"/>
		<property name="session" type="xs:integer"/>
		<property xmlns:d3p1="http://v8.1c.ru/8.1/data/core" name="request_id" type="d3p1:UUID"/>
		<property xmlns:d3p1="http://v8.1c.ru/8.1/data/core" name="user_id" type="d3p1:UUID"/>
	</objectType>
</package>