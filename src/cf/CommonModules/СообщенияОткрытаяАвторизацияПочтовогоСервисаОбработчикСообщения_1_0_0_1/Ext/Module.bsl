#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// ТехнологияСервиса.ОбменСообщениями

// Текущая (используемая вызывающим кодом) версия интерфейса сообщений.
//
// Возвращаемое значение:
//   Строка - номер версии интерфейса
//
Функция Версия() Экспорт
	
	Возврат "1.0.0.1";
	
КонецФункции

// Пространство имен текущей (используемой вызывающим кодом) версии интерфейса сообщений.
//
// Возвращаемое значение:
//   Строка - пространство имен интерфейса
//
Функция Пакет() Экспорт
	
	Возврат Метаданные.ПакетыXDTO.ОткрытаяАвторизацияПочтовогоСервиса_1_0_0_1.ПространствоИмен;
	
КонецФункции 

// Название программного интерфейса сообщений.
//
// Возвращаемое значение:
//   Строка - название программного интерфейса сообщений
//
Функция ПрограммныйИнтерфейс() Экспорт
	
	Возврат "ОткрытаяАвторизацияПочтовогоСервиса";
	
КонецФункции

// Базовый тип для сообщений версии.
//
// Возвращаемое значение:
//   ТипОбъектаXDTO - базовый тип XDTO для сообщений версии
//
Функция БазовыйТип() Экспорт
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса") Тогда
		ВызватьИсключение НСтр("ru = 'Отсутствует менеджер сервиса.'");
	КонецЕсли;
	
	МодульСообщенияВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("СообщенияВМоделиСервиса");
	
	Возврат МодульСообщенияВМоделиСервиса.ТипТело();
	
КонецФункции

// Обрабатывает входящие сообщения сервиса. При совпадении типа сообщения с типом обратного вызова
// формирует и отправляет серверное оповещение.
//
// Параметры:
//  Сообщение           - ОбъектXDTO - входящее сообщение
//  Отправитель         - ПланОбменаСсылка.ОбменСообщениями - узел плана обмена, соответствующий отправителю сообщения
//  СообщениеОбработано - Булево - флаг успешной обработки сообщения. Устанавливается в Истина,
//                                 если сообщение было успешно прочитано в обработчике
Процедура ОбработатьСообщениеМоделиСервиса(Сообщение, Отправитель, СообщениеОбработано) Экспорт
	
	ТипСообщения = Сообщение.Body.Тип();
	ТипОбратныйВызов = СообщенияОткрытаяАвторизацияПочтовогоСервисаИнтерфейсСлужебный.ТипОбратныйВызов();
	
	Если ТипСообщения = ТипОбратныйВызов Тогда
		
		Контекст = Новый Структура;
		Контекст.Вставить("КодАвторизации", Сообщение.Body.code);
		Контекст.Вставить("ИдентификаторЗапроса", Сообщение.Body.request_id);
		
		ПараметрыСерверногоОповещения = Новый Структура;
		ПараметрыСерверногоОповещения.Вставить("ИмяСобытия", "ОткрытаяАвторизацияПочтовогоСервиса");
		ПараметрыСерверногоОповещения.Вставить("Контекст", Контекст);
		
		ИмяСерверногоОповещения = РаботаСПочтовымиСообщениямиСлужебныйКлиентСервер.ИмяСерверногоОповещения();
		АдресатыСерверногоОповещения = АдресатыСерверногоОповещения(Сообщение.Body.session, Сообщение.Body.user_id);
		
		СерверныеОповещения.ОтправитьСерверноеОповещение(
			ИмяСерверногоОповещения,
			ПараметрыСерверногоОповещения,
			АдресатыСерверногоОповещения,
			Истина);
		
		СообщениеОбработано = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Конец ТехнологияСервиса.ОбменСообщениями

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует соответствие адресатов для отправки серверного оповещения по номеру сеанса и идентификатору пользователя.
//
// Параметры:
//   НомерСеанса - Число - номер сеанса информационной базы
//   ИдентификаторПользователя - УникальныйИдентификатор - идентификатор пользователя
//
// Возвращаемое значение:
//   Соответствие - адресаты для отправки серверного оповещения:
//     * Ключ - УникальныйИдентификатор - идентификатор пользователя
//     * Значение - Массив из см. СерверныеОповещения.КлючСеанса - ключ сеанса
//
Функция АдресатыСерверногоОповещения(НомерСеанса, ИдентификаторПользователя)
	
	АдресатыСерверногоОповещения = Новый Соответствие;
	
	АктивныеСеансы = ПолучитьСеансыИнформационнойБазы();
	НеобходимыйСеанс = Неопределено;
	
	Для Каждого АктивныйСеанс Из АктивныеСеансы Цикл
		Если АктивныйСеанс.НомерСеанса = НомерСеанса Тогда
			НеобходимыйСеанс = АктивныйСеанс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	КлючСеанса = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СерверныеОповещения.КлючСеанса(НеобходимыйСеанс));
	АдресатыСерверногоОповещения.Вставить(ИдентификаторПользователя, КлючСеанса);
	
	Возврат АдресатыСерверногоОповещения;
	
КонецФункции

#КонецОбласти