Функция НовыйПараметрыОткрытияФормыКомментария()
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("КлючЗаписиОбъектКЗагрузке", РаботаСРезультатамиОбменаКлиентСервер.НовыйКлючЗаписиОбъектыКЗагрузке()); 
	ПараметрыОткрытия.Вставить("Комментарий",               "");
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

Процедура ОповеститьОЗагрузкеОбъекта(ОбъектИБ)
	
	ТекстОповещения = СтрШаблон(НСтр("ru = 'Успешно загружен объект - %1'"), ОбъектИБ);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Загрузка объекта'"),
	                               ПолучитьНавигационнуюСсылку(ОбъектИБ),
	                               ТекстОповещения, БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

Процедура ОбработатьРезультатыВыполненияКомандыОбработки(РезультатОбработки, ЭтоПроверкаЗагрузки)

	Если Не РезультатОбработки.Успешно Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатОбработки.ТекстОшибки);
		
	Иначе
		
		ОповеститьПользователяОРезультатахВыполненияГрупповойКоманды(РезультатОбработки, ЭтоПроверкаЗагрузки);
		
		Если РезультатОбработки.ОповещатьОбИзменении Тогда
			Оповестить("Запись_ПричинаДобавленияОбъектыКЗагрузке");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

