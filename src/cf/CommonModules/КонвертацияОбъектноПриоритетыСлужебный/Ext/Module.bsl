#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПриоритетКонвертации(ПриоритетыКонвертации, ОбъектФормата, Приоритет, ПутьКДате, ЭтоДокумент)
	
	Если ПустаяСтрока(Строка(ОбъектФормата)) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОтборСтрок = Новый Структура;
	ОтборСтрок.Вставить("ОбъектФормата", ОбъектФормата);
	
	НайденныеСтроки = ПриоритетыКонвертации.НайтиСтроки(ОтборСтрок);
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	НоваяСтрока = ПриоритетыКонвертации.Добавить();
	НоваяСтрока.ОбъектФормата = ОбъектФормата;
	НоваяСтрока.Приоритет = ?(ЗначениеЗаполнено(Приоритет), Число(Приоритет), 0);
	НоваяСтрока.ПутьКДате = ПутьКДате;
	НоваяСтрока.ЭтоДокумент = ЭтоДокумент;
	
КонецПроцедуры

