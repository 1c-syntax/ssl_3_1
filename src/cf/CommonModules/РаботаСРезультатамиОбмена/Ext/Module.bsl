#Область Прочее

Функция СклонениеТипаМетаданных(МетаданныеОбъекта, Падеж)
	
	ИмяТипаМетаданных = РаботаСРезультатамиОбменаКлиентСервер.ИмяТипаМетаданныхПоПолномуИмени(МетаданныеОбъекта.ПолноеИмя());
	ПредставлениеТипаМетаданных = РаботаСРезультатамиОбменаКлиентСервер.ПредставлениеТипаМетаданных(ИмяТипаМетаданных);
	
	СклоненияСтроки = ПолучитьСклоненияСтроки(ПредставлениеТипаМетаданных,,"ПД=" + Падеж);
	
	Возврат СклоненияСтроки[0];
	
КонецФункции

Функция ТекстВопросаПриЗаписиСОшибкой(МетаданныеОбъекта, ПричинаДобавления)
	
	ШаблонВопроса = "";
	ТекстПриЗаписи = "";
	ТекстЗагрузить = "";
	
	Если ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаЗаписи Тогда
		
		ШаблонВопроса = НСтр("ru = 'При записи %1 без проверки заполнения возникла ошибка. Загрузить %2 c ошибкой записи?'");
		
	ИначеЕсли ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаПроверкиПриЗаписи Тогда
		
		ШаблонВопроса = НСтр("ru = 'При записи %1 с проверкой заполнения возникла ошибка. Загрузить %2 c ошибкой записи?'");
		
	ИначеЕсли ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаПроведения Тогда
		
		Возврат НСтр("ru = 'При проведении документа возникла ошибка. Загрузить документ непроведенным?'");
		
	Иначе
		
		Возврат ШаблонВопроса;
		
	КонецЕсли;
	
	ТекстЗагрузить = НРег(СклонениеТипаМетаданных(МетаданныеОбъекта, "Именительный"));
	ТекстПриЗаписи = НРег(СклонениеТипаМетаданных(МетаданныеОбъекта, "Родительный")); 
	
	Возврат СтрШаблон(ШаблонВопроса, ТекстПриЗаписи, ТекстЗагрузить);
	
КонецФункции

