Процедура ФиксироватьПредупреждениеБлокировкиОбъекта(КомпонентыОбмена, ДанныеИБ) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеОбъектнойБлокировкиОбъекта = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекстаПредупреждения = НСтр("ru = 'Не удалось установить объектную блокировку перед конвертацией
	|по причине: объект уже заблокирован.
	|	
	|	Объект: %1
	|	Идентификатор: %2
	|	Переход по ссылке: %3
	|
	|Возможно форма объекта была открыта пользователем или выполнялась параллельная конвертация.
	|
	|Описание для разработчика:
	|{см. КонвертацияОбъектноСлужебный.ЗаблокироватьОбъектИБ()}'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		
		УИД = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Навигация = ПолучитьНавигационнуюСсылку(ДанныеИБ.Ссылка);
		
	КонецЕсли;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекстаПредупреждения, ДанныеИБ.Ссылка, УИД, Навигация);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеБлокировкиОбъекта"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки",   "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеДублейСопоставлений(КомпонентыОбмена, ДублиСопоставлений, ВнешняяСсылка) Экспорт
	
	// Ситуация, когда внешний идентификатор (ссылка) по данным регистра ПИСО
	// соответствует нескольким ссылкам в ИБ не является ошибкой.
	// Отразим этот нюанс в журнале регистрации и продолжим работу.
	// Флаг "ЕстьОшибка* или ЕстьПредупреждение*" взводить не требуется.
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекстаПредупреждения = НСтр("ru = 'В приложении зафиксировано несколько соответствий внешнему (входящему) идентификатору.
	|	
	|	Внешний идентификатор: %1
	|	Список соответствий: %2
	|
	|Возможно требуется актуализировать сведения о сопоставлении данных.
	|
	|Описание для разработчика:
	|{см. регистр сведений ПубличныеИдентификаторыСинхронизируемыхОбъектов}'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ПредставлениеДублей = "";
	Для каждого ДубльИзПИСО Из ДублиСопоставлений Цикл
		
		ПредставлениеДублей = ПредставлениеДублей + Символы.ПС + "		- " + СокрЛП(ДубльИзПИСО);
		
	КонецЦикла;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекстаПредупреждения, ВнешняяСсылка, ПредставлениеДублей);
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки",   "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеИзмененияНеразделенныхДанных(КомпонентыОбмена, ДанныеИБ, ЭтоУдаление = Ложь) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеИзмененияНеразделенныхДанных = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекстаПредупреждения = НСтр("ru = 'Зафиксирована попытка изменения неразделенных данных в разделенном режиме.
	|	
	|	Метаданные: %1
	|	Ссылка: %2
	|	Идентификатор: %3
	|	Переход по ссылке: %4
	|
	|Изменение указанного объекта было проигнорировано.
	|
	|Описание для разработчика:
	|{см. КонвертацияОбъектноСлужебный.РазрешенаЗаписьОбъектаВРазделеннойИБ()}'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		
		ИмяТаблицы = ДанныеИБ.Ссылка.Метаданные().ПолноеИмя();
		УИД = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Навигация = ПолучитьНавигационнуюСсылку(ДанныеИБ.Ссылка);
		
	КонецЕсли;
	
	Если ЭтоУдаление = Истина Тогда
		
		ШаблонТекстаПредупреждения = СтрЗаменить(ШаблонТекстаПредупреждения,
			НСтр("ru = 'попытка изменения неразделенных'", ОбщегоНазначения.КодОсновногоЯзыка()),
			НСтр("ru = 'попытка удаления неразделенных'", ОбщегоНазначения.КодОсновногоЯзыка()));
			
		ШаблонТекстаПредупреждения = СтрЗаменить(ШаблонТекстаПредупреждения,
			НСтр("ru = 'Изменение указанного объекта'", ОбщегоНазначения.КодОсновногоЯзыка()),
			НСтр("ru = 'Удаление указанного объекта'", ОбщегоНазначения.КодОсновногоЯзыка()));
		
	КонецЕсли;
		
	ТекстПредупреждения = СтрШаблон(ШаблонТекстаПредупреждения, ИмяТаблицы, ДанныеИБ.Ссылка, УИД, Навигация);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеИзмененияНеразделенныхДанных"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеБлокировкиОбъектаДругимиОбъектами(КомпонентыОбмена) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ВнешняяСсылкаСтрокой = КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ВнешняяСсылкаСтрокой;
	Если ПустаяСтрока(ВнешняяСсылкаСтрокой) Тогда // Такого быть не должно, но ...
		
		ВнешняяСсылкаСтрокой = НСтр("ru ='<Идентификатор не указан>'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	КонецЕсли;
	
	ШаблонТекстаЗаголовка =  НСтр("ru ='Загрузка объекта невозможна.
		|	Тип: %1
		|	Объект: %2
		|	УИД: %3
		|
		|Причина отказа загрузки:
		|%4'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	
	ИсторияПримененияТекущегоПКО = КомпонентыОбмена.ИсторияПримененияТекущегоПКО;
	ПравилоКонвертации = ИсторияПримененияТекущегоПКО.ПравилоКонвертации;
	ИмяТипа = ПравилоКонвертации.ИмяТаблицыПолученныхДанных;
	СсылкаНаОбъект = КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ДанныеИБСсылка;
	
	ОписаниеКонвертируемогоОбъекта = НСтр("ru ='<Новый объект>'", ОбщегоНазначения.КодОсновногоЯзыка());
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		
		ОписаниеКонвертируемогоОбъекта = КонвертацияОбъектноРецепцияСервер.ПредставлениеОбъектаДляПротокола(СсылкаНаОбъект);
		
	КонецЕсли;
	
	ОписаниеНедостающихСсылок = "";
	Для каждого ОписаниеБлокера Из ИсторияПримененияТекущегоПКО.СсылкиБлокирующиеКонвертацию Цикл
		
		Если ПустаяСтрока(ОписаниеБлокера.БлокирующийИдентификатор) Тогда
			
			// Обязательно должно быть 2 ссылки:
			// - что заблокировано;
			// - чем заблокировано.
			Продолжить;
			
		КонецЕсли;
		
		ПредставлениеБлокировкиОбъекта(ОписаниеНедостающихСсылок, ОписаниеБлокера, ИмяТипа);
		
	КонецЦикла;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекстаЗаголовка, ИмяТипа, ОписаниеКонвертируемогоОбъекта, ВнешняяСсылкаСтрокой, ОписаниеНедостающихСсылок);
	ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеБлокировкиОбъектаДругимиОбъектами"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	// Отразим блокировку в журнале регистрации
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеЗапросаНаВыгрузкуСсылкаНеНайдена(КомпонентыОбмена, ОписаниеСсылкиЗапроса) Экспорт
	
	ОписаниеОшибки = НСтр("ru = 'Ссылка с идентификатором %1 по объекту формата %2 не будет повторно выгружена,
							|т.к. ей не найдено соответствие в этом приложении.'");
	
	ИдентификаторИзЗапроса = ОписаниеСсылкиЗапроса.СсылкаЗапросаНаВыгрузку;
	ИмяОбъектаФормата = ОписаниеСсылкиЗапроса.ИмяОбъектаФорматаПолученного;
	
	ПредставлениеПредупреждения = СтрШаблон(ОписаниеОшибки, ИдентификаторИзЗапроса, ИмяОбъектаФормата);
	Если НЕ ПустаяСтрока(ОписаниеСсылкиЗапроса.СсылкаВнешняяНавигационная) Тогда
		
		ПредставлениеПредупреждения = ПредставлениеПредупреждения + Символы.ПС + ОписаниеСсылкиЗапроса.СсылкаВнешняяНавигационная;
		
	КонецЕсли;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки",   ПредставлениеПредупреждения);
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ПредставлениеПредупреждения);
	
	// Предупреждение фиксируем только в ЖР, не отражая в результатах обмена.
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеЗапросаНаВыгрузкуСсылкаНеПроходитФильтр(КомпонентыОбмена, ОписаниеСсылкиЗапроса, ПодобраннаяОбъектнаяСсылка) Экспорт
	
	ШаблонТекста = НСтр("ru = 'Объект %1 не будет повторно выгружен, т.к. не соответствует условиям фильтра.'");
	
	ПредставлениеСсылки = КонвертацияОбъектноРецепцияСервер.ПредставлениеОбъектаДляПротокола(ПодобраннаяОбъектнаяСсылка);
	
	ПредставлениеПредупреждения = СтрШаблон(ШаблонТекста, ПредставлениеСсылки);
	Если НЕ ПустаяСтрока(ОписаниеСсылкиЗапроса.СсылкаВнешняяНавигационная) Тогда
		
		ПредставлениеПредупреждения = ПредставлениеПредупреждения + Символы.ПС + ОписаниеСсылкиЗапроса.СсылкаВнешняяНавигационная;
		
	КонецЕсли;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки",   ПредставлениеПредупреждения);
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ПредставлениеПредупреждения);
	
	// Предупреждение фиксируем только в ЖР, не отражая в результатах обмена.
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеНеизвестныйОбъектФормата(КомпонентыОбмена, ПространствоИмен, ИмяОбъектаФормата, ТекстОшибки) Экспорт
	
	// Это событие не работает с флагами из ИсторияПримененияТекущегоПКО,
	// не блокирует обмен, не формирует записей об ошибках - только предупреждение.
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекста = НСтр("ru ='Обнаружена неудачная попытка создания объекта формата.
	|	
	|	Пространство имен: %1
	|	Имя объекта: %2
	|
	|Описание для разработчика:
	|%3'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекста, ПространствоИмен, ИмяОбъектаФормата, ТекстОшибки);
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьОтказОтКонвертацииОбъекта(КомпонентыОбмена) Экспорт
	
	// Это событие фиксирует ситуацию, когда в ПКО отказались конвертировать данные:
	// - ПолученныеДанные = Неопределено и ДанныеИБ = Неопределено.
	// С позиции конвертации ошибки нет, т.к. это решение принято разработчиком прикладных правил,
	// но проинформировать нужно.
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьИнформированиеОтказаОтКонвертацииОбъекта = Истина;
	
	ШаблонТекста = НСтр("ru ='Загрузка данных выполнена, но в результате не потребовалось создавать или обновлять объекты.
	|Такая ситуация возникает, когда алгоритм намеренно отказался от загрузки объекта.
	|
	|	ПОД: %1
	|	ПКО: %2
	|	Идентификатор: %3
	|
	|Описание для разработчика:
	|Получены пустые значения в переменных ПолученныеДанные и ДанныеИБ.
	|{см. КонвертацияОбъектноСлужебный.ПередЗаписьюПолученныхДанных()}'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ИсторияКонвертацииОбъекта = КомпонентыОбмена.ИсторияКонвертацииОбъекта;
	ИсторияПримененияТекущегоПКО = КомпонентыОбмена.ИсторияПримененияТекущегоПКО;
	
	ИмяПОД = ИсторияКонвертацииОбъекта.ЗначениеПОД.Имя;
	ИмяПКО = ИсторияПримененияТекущегоПКО.ПравилоКонвертации.ИмяПКО;
	ИдентификаторОбъекта = ИсторияПримененияТекущегоПКО.ВнешняяСсылкаСтрокой;
	
	ТекстИнформирования = СтрШаблон(ШаблонТекста, ИмяПОД, ИмяПКО, ИдентификаторОбъекта);
	ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ИнформированиеОтказаОтКонвертацииОбъекта"] = ТекстИнформирования;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстИнформирования);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, Неопределено, Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеПриПроведении(КомпонентыОбмена, ДанныеИБ, ТекстОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеПриПроведении = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекста = НСтр("ru ='Не удалось провести документ.
	|	
	|	Метаданные: %1
	|	Ссылка: %2
	|	Идентификатор: %3
	|	Переход по ссылке: %4
	|
	|Описание для разработчика:
	|%5'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		
		ИмяТаблицы = ДанныеИБ.Ссылка.Метаданные().ПолноеИмя();
		УИД = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Навигация = ПолучитьНавигационнуюСсылку(ДанныеИБ.Ссылка);
		
	КонецЕсли;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекста, ИмяТаблицы, ДанныеИБ.Ссылка, УИД, Навигация, ТекстОшибки);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеПриПроведении"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, , Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеПриЗаписиОбъекта(КомпонентыОбмена, ДанныеИБ, ТекстОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеПриЗаписи = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекста = НСтр("ru ='Не удалось записать объект в пользовательском режиме (с проверкой заполнения).
	|	
	|	Метаданные: %1
	|	Ссылка: %2
	|	Идентификатор: %3
	|	Переход по ссылке: %4
	|
	|Описание для разработчика:
	|%5'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ПравилоКонвертации.ЭтоСсылочныйТип
		И ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		
		ИмяТаблицы = ДанныеИБ.Ссылка.Метаданные().ПолноеИмя();
		УИД = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Навигация = ПолучитьНавигационнуюСсылку(ДанныеИБ.Ссылка);
		
	КонецЕсли;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекста, ИмяТаблицы, СокрЛП(ДанныеИБ), УИД, Навигация, ТекстОшибки);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеПриЗаписи"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, , Ложь);
	
КонецПроцедуры

Процедура ФиксироватьПредупреждениеПриСохраненииОбъекта(КомпонентыОбмена, ДанныеИБ, ТекстОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеПриСохранении = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекста = НСтр("ru ='Не удалось сохранить объект в режиме разработчика (без проверки заполнения).
	|	
	|	Метаданные: %1
	|	Ссылка: %2
	|	Идентификатор: %3
	|	Переход по ссылке: %4
	|
	|Фактически это предупреждение говорит о том, что результат конвертации указанного объекта не зафиксирован.
	|
	|Описание для разработчика:
	|%5'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если ЗначениеЗаполнено(ДанныеИБ.Ссылка) Тогда
		
		ИмяТаблицы = ДанныеИБ.Ссылка.Метаданные().ПолноеИмя();
		УИД = ДанныеИБ.Ссылка.УникальныйИдентификатор();
		Навигация = ПолучитьНавигационнуюСсылку(ДанныеИБ.Ссылка);
		
	КонецЕсли;
	
	ТекстПредупреждения = СтрШаблон(ШаблонТекста, ИмяТаблицы, ДанныеИБ.Ссылка, УИД, Навигация, ТекстОшибки);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеПриСохранении"] = ТекстПредупреждения;
	
	ОписаниеПредупреждения = Новый Структура;
	ОписаниеПредупреждения.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение);
	ОписаниеПредупреждения.Вставить("КраткоеПредставлениеОшибки", "");
	ОписаниеПредупреждения.Вставить("ПодробноеПредставлениеОшибки", ТекстПредупреждения);
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ОписаниеПредупреждения, , Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область РасшифровкаОшибок

// Получает причину добавления ошибки, которая возникла при работе Правил Конвертации Объекта (существующего).
//
// Параметры:
//   ИсторияПримененияПКО - см. КонвертацияОбъектноРезультатыСлужебный.КонструкторИсторииПримененияПКО
// 
// Возвращаемое значение:
//   ПеречислениеСсылка.ПричиныДобавленияВРегистрОбъектыКЗагрузке, Неопределено - 
//    "Неопределено" если ошибка не соответствует ожидаемым типам
//
Функция ПричинаДобавленияОшибкиПКО(ИсторияПримененияПКО) Экспорт
	
	ПричинаДобавления = Неопределено;
	Если ИсторияПримененияПКО.ЕстьПредупреждениеПриСохранении = Истина Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаЗаписи;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриЗаписи = Истина Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаПроверкиПриЗаписи;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриПроведении = Истина Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаПроведения;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеУстановитьВручнуюСоответствие = Истина Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ТребуетсяПоискСоответствия;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных = Истина Тогда 
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ТребуетсяПодтверждение;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами = Истина Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОжидаетЗагрузкуДругихОбъектов;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСтруктурыXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаОпределенияПКО = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаПоддерживаемыхОбъектовXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьПредупреждениеИзмененияНеразделенныхДанных = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПередЗаписьюПолученныхДанных = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПослеКонвертацииОбъекта = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаОбработкиУдаленияОбъекта = Истина
		Тогда
		
		ПричинаДобавления = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаКонвертации;
		
	Иначе
		
		// Нет ошибок или :
		// - ИсторияПримененияПКО.ЕстьПредупреждениеОбъектнойБлокировкиОбъекта = Истина
		// - ИсторияПримененияПКО.ЕстьИнформированиеОтказаОтКонвертацииОбъекта ИсторияПримененияПКО
		
	КонецЕсли;
	
	Возврат ПричинаДобавления;
	
КонецФункции

// Определяет, возникала ли ошибка конвертации при загрузке объекта
//
// Параметры:
//   ИсторияКонвертацииОбъекта - см. КонвертацияОбъектноРезультатыСлужебный.КонструкторИсторииПримененияПОД
// 
// Возвращаемое значение:
//   Булево 
//
Функция ВозниклаОшибкаКонвертации(ИсторияКонвертацииОбъекта) Экспорт
	
	Если ИсторияКонвертацииОбъекта.ЕстьОшибкаНепредвиденногоИсключения
		Или ИсторияКонвертацииОбъекта.ЕстьОшибкаОбработкиЗапросаВыгрузкиОбъекта
		Или ИсторияКонвертацииОбъекта.ЕстьОшибкаОпределенияПОД
		Или ИсторияКонвертацииОбъекта.ЕстьОшибкаОпределенияТипаОбъектаXDTO
		Или ИсторияКонвертацииОбъекта.ЕстьОшибкаСобытияПриОбработкеПОД 
		Или ИсторияКонвертацииОбъекта.ЕстьОшибкаДесериализацииПоТипуXDTO Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

// Получает статус ошибки, которая возникла при работе Правил Конвертации Объекта.
//
// Параметры:
//   ИсторияПримененияПКО - см. КонвертацияОбъектноРезультатыСлужебный.КонструкторИсторииПримененияПКО
// 
// Возвращаемое значение:
//   ПеречислениеСсылка.СтатусыОбновленияОбъектаПриПроблемахЗаписи, Неопределено - 
//    "Неопределено" если ошибка не соответствует ожидаемым типам
//
Функция СтатусОшибкиПКО(ИсторияПримененияПКО) Экспорт
	
	СтатусОбновленияОбъектаВИБ = Неопределено;
	Если ИсторияПримененияПКО.ЕстьПредупреждениеПриСохранении = Истина Тогда
		
		СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриЗаписи = Истина Тогда
		
		Если ИсторияПримененияПКО.ЭтоНовыйОбъект = Истина Тогда
			
			СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.ЗагруженСозданНовый;
			
		Иначе
			
			ИмяСтратегии = КонвертацияОбъектноСлужебный.ИмяСтратегииСохранения();
			СохранениеБылоРазрешено = (СтрНайти(ИсторияПримененияПКО.СтратегияЗаписиОбъекта, ИмяСтратегии) > 0);
			Если СохранениеБылоРазрешено Тогда
				
				СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.ЗагруженОбновлен;
				
			Иначе
				
				СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриПроведении = Истина Тогда
		
		Если ИсторияПримененияПКО.ЭтоНовыйОбъект = Истина Тогда
			
			СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.ЗагруженСозданНовый;
			
		Иначе
			
			ИмяСтратегии = КонвертацияОбъектноСлужебный.ИмяСтратегииЗаписи();
			ЗаписьБылаРазрешена = (СтрНайти(ИсторияПримененияПКО.СтратегияЗаписиОбъекта, ИмяСтратегии) > 0);
			Если ЗаписьБылаРазрешена Тогда
				
				// Загружался не проведенный документ
				СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.ЗагруженОбновлен;
				
			Иначе
				
				СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеУстановитьВручнуюСоответствие = Истина Тогда
		
		СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеСоздан;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСтруктурыXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаОпределенияПКО = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаПоддерживаемыхОбъектовXDTO = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьПредупреждениеИзмененияНеразделенныхДанных = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПередЗаписьюПолученныхДанных = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию = Истина
		ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПослеКонвертацииОбъекта = Истина
		Тогда
		
		Если ИсторияПримененияПКО.ЭтоНовыйОбъект = Истина Тогда
			
			СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеСоздан;
			
		Иначе
			
			СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
			
		КонецЕсли;
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаОбработкиУдаленияОбъекта = Истина Тогда
		
		СтатусОбновленияОбъектаВИБ = Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
		
	Иначе
		
		// Нет ошибок или :
		// - ИсторияПримененияПКО.ЕстьПредупреждениеОбъектнойБлокировкиОбъекта = Истина
		// - ИсторияПримененияПКО.ЕстьИнформированиеОтказаОтКонвертацииОбъекта ИсторияПримененияПКО
		
	КонецЕсли;
	
	Возврат СтатусОбновленияОбъектаВИБ;
	
КонецФункции

// Получает текст ошибки, которая возникла при работе Правил Конвертации Объекта (нового).
//
// Параметры:
//   ИсторияПримененияПКО - см. КонвертацияОбъектноРезультатыСлужебный.КонструкторИсторииПримененияПКО
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеОшибкиПКО(ИсторияПримененияПКО) Экспорт
	
	ПолноеПредставлениеОшибки = "";
	Если ИсторияПримененияПКО.ЕстьПредупреждениеПриСохранении = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеПриСохранении"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриЗаписи = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеПриЗаписи"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриПроведении = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеПриПроведении"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеУстановитьВручнуюСоответствие = Истина Тогда
	
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеУстановитьВручнуюСоответствие"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеБлокировкиОбъектаДругимиОбъектами"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСтруктурыXDTO = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаКонвертацииСтруктурыXDTO"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаКонвертацииСвойстваСтруктурыXDTO"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаОпределенияПКО = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаОпределенияПКО"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаПоддерживаемыхОбъектовXDTO = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаПоддерживаемыхОбъектовXDTO"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеИзмененияНеразделенныхДанных = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеИзмененияНеразделенныхДанных"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеОбъектнойБлокировкиОбъекта = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ПредупреждениеОбъектнойБлокировкиОбъекта"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаСобытияПередЗаписьюПолученныхДанных = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаСобытияПередЗаписьюПолученныхДанных"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаСобытияПослеКонвертацииОбъекта = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаСобытияПослеКонвертацииОбъекта"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаОбработкиУдаленияОбъекта = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ОшибкаОбработкиУдаленияОбъекта"];
		
	ИначеЕсли ИсторияПримененияПКО.ЕстьИнформированиеОтказаОтКонвертацииОбъекта = Истина Тогда
		
		ПолноеПредставлениеОшибки = ИсторияПримененияПКО.ТекстыОшибокПКО["ИнформированиеОтказаОтКонвертацииОбъекта"];
		
	КонецЕсли;
	
	Возврат ПолноеПредставлениеОшибки;
	
КонецФункции

#КонецОбласти

// Возвращаемое значение:
//   Строка
//
Функция СобытиеЖурналаРегистрацииИнтерактивногоЗапускаОбъектнойКонвертации() Экспорт
	
	Возврат НСтр("ru = 'Обмен данным.Объектно.Интерактивная конвертация'", ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецФункции

Процедура ОтразитьОшибкиПредупрежденияПослеКонвертации(КомпонентыОбмена, ВыборкаДанныхДляОбработки) Экспорт
	
	ЕстьОшибкиПОД = ЕстьОшибкиПОД(КомпонентыОбмена.ИсторияКонвертацииОбъекта);
	
	// Если есть ошибки ПОД, то до выполнения ПКО алгоритм не дошел
	Если ЕстьОшибкиПОД Тогда
		
		ОтразитьОшибкуКонвертацииПОД(КомпонентыОбмена, ВыборкаДанныхДляОбработки);
		
	Иначе
		
		ОтразитьОшибкиКонвертацииПКО(КомпонентыОбмена, ВыборкаДанныхДляОбработки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьОтметкаОПроблемеЗаписиОбъекта(ПричиныДобавления = Неопределено) Экспорт
	
	Если ПричиныДобавления = Неопределено Тогда
		
		МассивПричинДобавления = Новый Массив(2);
		МассивПричинДобавления[0] = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаПроверкиПриЗаписи;
		МассивПричинДобавления[1] = Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаЗаписи;
		
	ИначеЕсли ТипЗнч(ПричиныДобавления) = Тип(Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ПустаяСсылка()) Тогда
		
		МассивПричинДобавления = Новый Массив(1);
		МассивПричинДобавления[0] = ПричиныДобавления;
		
	Иначе
		
		МассивПричинДобавления = ПричиныДобавления;
		
	КонецЕсли;
	
	Возврат РегистрыСведений.ОбъектыКЗагрузке.ЕстьОтметкаОПроблеме(МассивПричинДобавления);
	
КонецФункции

Функция ЕстьОшибкиПКО(ИсторияПримененияПКО) Экспорт
	
	Для каждого ЗаписьСтруктуры Из ИсторияПримененияПКО Цикл
		
		Если (СтрНайти(ЗаписьСтруктуры.Ключ, "ЕстьОшибка") > 0
				ИЛИ СтрНайти(ЗаписьСтруктуры.Ключ, "ЕстьПредупреждение") > 0)
			И ЗаписьСтруктуры.Значение = Истина Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьОшибкиПОД(ИсторияКонвертацииОбъекта) Экспорт
	
	Для каждого ЗаписьСтруктуры Из ИсторияКонвертацииОбъекта Цикл
		
		Если (СтрНайти(ЗаписьСтруктуры.Ключ, "ЕстьОшибка") > 0
				ИЛИ СтрНайти(ЗаписьСтруктуры.Ключ, "ЕстьПредупреждение") > 0)
			И ЗаписьСтруктуры.Значение = Истина Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Получает текст ошибки, которая возникла при работе ПОД.
//
// Параметры:
//   ИсторияКонвертацииОбъекта - см. КонвертацияОбъектноРезультатыСлужебный.КонструкторИсторииПримененияПОД
//
// Возвращаемое значение:
//   Строка
//
Функция ПредставлениеОшибкиПОД(ИсторияКонвертацииОбъекта)
	
	ПолноеПредставлениеОшибки = "";
	ТекстыОшибокПОД = ИсторияКонвертацииОбъекта.ТекстыОшибокПОД;
	
	Для каждого ЭлементСтруктуры Из ИсторияКонвертацииОбъекта Цикл
		
		Если СтрНайти(ЭлементСтруктуры.Ключ, "Есть") > 0
			И ЭлементСтруктуры.Значение = Истина Тогда
			
			ИмяКлюча = СтрЗаменить(ЭлементСтруктуры.Ключ, "Есть", "");
			ПолноеПредставлениеОшибки = ТекстыОшибокПОД[ИмяКлюча];
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПолноеПредставлениеОшибки;
	
КонецФункции

// Возвращает причину добавления ошибки, которая возникла при работе ПОД.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.ПричиныДобавленияВРегистрОбъектыКЗагрузке
//
Функция ПричинаДобавленияОшибкиПОД()
	
	Возврат Перечисления.ПричиныДобавленияВРегистрОбъектыКЗагрузке.ОшибкаКонвертации;
	
КонецФункции

// Параметры:
//   СтепеньСжатия - Число - степень сжатия
//   
// Возвращаемое значение:
//   СжатиеДанных
//
Функция СжатиеДанныхПриОтраженииПроблемКонвертации(СтепеньСжатия = 6)
	
	Возврат Новый СжатиеДанных(СтепеньСжатия);
	
КонецФункции

// Возвращает статус ошибки, которая возникла при работе ПОД.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.СтатусыОбновленияОбъектаПриПроблемахЗаписи
//
Функция СтатусОшибкиПОД()
	
	Возврат Перечисления.СтатусыОбновленияОбъектаПриПроблемахЗаписи.НеЗагруженНеОбновлен;
	
КонецФункции

Процедура ОтметитьНаличиеПредупреждения(КомпонентыОбмена)
	
	Если НЕ КомпонентыОбмена.Свойство("СостояниеОбменаДанными") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Неопределено
		ИЛИ КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.Выполнено Тогда
		
		КомпонентыОбмена.СостояниеОбменаДанными.РезультатВыполненияОбмена = Перечисления.РезультатыВыполненияОбмена.ВыполненоСПредупреждениями;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПредставлениеБлокировкиОбъекта(ОписаниеНедостающихСсылок, ОписаниеБлокера, ИмяТипа)
	
	ШаблонОписанияСсылки = НСтр("ru ='- нет соответствия для входящего идентификатора %1,
		|из-за этого не получается заполнить реквизит объекта %2.
		|Необходимо назначить соответствие вручную или прислать в это приложение полную выгрузку объекта,
		|который соответствует идентификатору %1.'",
		ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если НЕ ПустаяСтрока(ОписаниеНедостающихСсылок) Тогда
		
		Разделитель = "--------------------------------------------------------------------------";
		ОписаниеНедостающихСсылок = ОписаниеНедостающихСсылок + Символы.ПС + Символы.ПС + Разделитель + Символы.ПС;
		
	КонецЕсли;
	
	ПредставлениеСвойства = ИмяТипа + "." + ОписаниеБлокера.ИмяРеквизита;
	
	ОписаниеНедостающихСсылок = ОписаниеНедостающихСсылок
		+ СтрШаблон(ШаблонОписанияСсылки,
			ОписаниеБлокера.БлокирующийИдентификатор,	// UID вложенной ссылки, которую не смогли распознать (UID блокера)
			ПредставлениеСвойства);						// Имя свойства конвертируемого объекта, которое не смогли заполнить
	
КонецПроцедуры

#Область ОтражениеОшибокНаОбъектыКЗагрузке

Функция ПредставлениеОбъектаJSONВХранилищеЗначений(ПредставлениеОбъектаJSON)
	
	Если НЕ ЗначениеЗаполнено(ПредставлениеОбъектаJSON) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	СжатиеДанных = СжатиеДанныхПриОтраженииПроблемКонвертации();
	Возврат Новый ХранилищеЗначения(ПредставлениеОбъектаJSON, СжатиеДанных);
	
КонецФункции

Функция ИдентификаторОбъектаМетаданныхИзПравилаКонвертации(ПравилоКонвертации)
	
	ОбъектМетаданных = Неопределено;
	Если ПравилоКонвертации = Неопределено Тогда
		
		Возврат ОбъектМетаданных;
		
	КонецЕсли;
	
	Если ПравилоКонвертации.ОбъектДанных <> Неопределено Тогда
		
		ОбъектМетаданных = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ПравилоКонвертации.ОбъектДанных);
		
	КонецЕсли;
	
	Возврат ОбъектМетаданных;
	
КонецФункции

Процедура ОтразитьОшибкиКонвертацииПКО(КомпонентыОбмена, ВыборкаДанныхДляОбработки)
	
	ЭтоСложнаяКонвертация               = (КомпонентыОбмена.ИсторияПримененияПКО.Количество() > 1);
	ИмяОперацииОценкаПроизводительности = "ЗаписьНовойПричиныДобавленияОбъектыКЗагрузке";
	
	Для каждого ЭлементСоответствия Из КомпонентыОбмена.ИсторияПримененияПКО Цикл
		
		ВремяНачала = ОбменДаннымиОценкаПроизводительности.НачатьЗамер();
		
		ИмяПКО = ЭлементСоответствия.Ключ;
		ИсторияПримененияПКО = ЭлементСоответствия.Значение;
		
		Если ТипЗнч(ИсторияПримененияПКО) <> Тип("Структура") Тогда
			
			Продолжить; // Например, "Неопределено", если ПКО не использовалось или были ошибки ПОД. Пропустим.
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаКонвертацииСтруктурыXDTO = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьОшибкаОпределенияПКО = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьОшибкаПоддерживаемыхОбъектовXDTO = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПередЗаписьюПолученныхДанных = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьОшибкаСобытияПослеКонвертацииОбъекта = Истина
			Тогда
			
			ОтразитьОшибкуВыполненияПКО(КомпонентыОбмена, ИмяПКО, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки);
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами = Истина Тогда
			
			ОтразитьПроблемуОтсутствующихСсылок(КомпонентыОбмена, ИмяПКО, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки);
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеУстановитьВручнуюСоответствие = Истина Тогда
			
			ОтразитьПроблемуТребующуюУстановкиСоответствияВручную(КомпонентыОбмена, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки);
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных = Истина Тогда
			
			ОтразитьНеобходимостьПодтвержденияЗагрузкиДанных(КомпонентыОбмена, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки);
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьПредупреждениеПриПроведении = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьПредупреждениеПриЗаписи = Истина
			ИЛИ ИсторияПримененияПКО.ЕстьПредупреждениеПриСохранении = Истина
			Тогда
			
			ОтразитьПроблемуЗаписиОбъекта(ИмяПКО, ИсторияПримененияПКО, ЭтоСложнаяКонвертация, ВыборкаДанныхДляОбработки);
			
		ИначеЕсли ИсторияПримененияПКО.ЕстьОшибкаОбработкиУдаленияОбъекта = Истина Тогда
			
			ОтразитьПроблемуУдаленияОбъекта(ИмяПКО, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки);
			
		Иначе
			
			// Если хоть одно ПКО отработано удачно, то можно попробовать снять блокировку,
			// т.к. часть, которая удачно обработана снимает проблему конвертации других объектов
			РегистрыСведений.ОбъектыБлокирующиеЗагрузку.СнятьБлокировкуОбъектомДругихОбъектов(ВыборкаДанныхДляОбработки.ПолученныйОбъект);
			КомпонентыОбмена.СчетчикЗагруженныхОбъектов = КомпонентыОбмена.СчетчикЗагруженныхОбъектов + 1;
			
			ИмяОперацииОценкаПроизводительности = "СнятиеБлокировкиОбъектомДругихОбъектов";
			
		КонецЕсли;
		
		ОбменДаннымиОценкаПроизводительности.ЗавершитьЗамер(
				ВремяНачала, ИмяОперацииОценкаПроизводительности, "", КомпонентыОбмена, 
				ОбменДаннымиОценкаПроизводительности.ТипСобытияБиблиотека());
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтразитьОшибкуКонвертацииПОД(КомпонентыОбмена, ВыборкаДанныхДляОбработки)
	
	ВремяНачала = ОбменДаннымиОценкаПроизводительности.НачатьЗамер();
	
	ДанныеЗаписи = РегистрыСведений.ОбъектыКЗагрузке.НовыйДанныеОбработкиОбъекта();
	ДанныеЗаписи.ПолученныйОбъект = ВыборкаДанныхДляОбработки.ПолученныйОбъект;
	ДанныеЗаписи.ОбъектФормата = ВыборкаДанныхДляОбработки.ОбъектФормата;
	ДанныеЗаписи.УзелПланаОбмена = ВыборкаДанныхДляОбработки.УзелПланаОбмена;
	ДанныеЗаписи.ДатаОбрабатываемойВерсии = ВыборкаДанныхДляОбработки.ДатаДобавления;
	ДанныеЗаписи.ПричинаДобавления = ПричинаДобавленияОшибкиПОД();
	ДанныеЗаписи.СтатусОбновленияОбъектаВИБ = СтатусОшибкиПОД();
	ДанныеЗаписи.ПолноеПредставлениеОшибки = ПредставлениеОшибкиПОД(КомпонентыОбмена.ИсторияКонвертацииОбъекта);

	// Пропускаем:
	// - ПравилоКонвертации: упали при выполнении ПОД, еще не знаем, какие ПКО должны были бы выполниться
	// - ОбъектМетаданных: и по каким метаданным
	РегистрыСведений.ОбъектыКЗагрузке.ОтразитьОбработкуОбъекта(ДанныеЗаписи);
	
	ОбменДаннымиОценкаПроизводительности.ЗавершитьЗамер(
			ВремяНачала, "ЗаписьНовойПричиныДобавленияОбъектыКЗагрузке", "", КомпонентыОбмена, 
			ОбменДаннымиОценкаПроизводительности.ТипСобытияБиблиотека());
	
КонецПроцедуры

Процедура ОтразитьОшибкуВыполненияПКО(КомпонентыОбмена, ИмяПКО, ИсторияПримененияПКО, ВыборкаДанныхДляОбработки)
	
	ОбъектМетаданных = ИдентификаторОбъектаМетаданныхИзПравилаКонвертации(ИсторияПримененияПКО.ПравилоКонвертации);
	ДанныеСконвертированногоОбъекта = ПредставлениеОбъектаJSONВХранилищеЗначений(ИсторияПримененияПКО.ПолученныеДанныеJSON);
	
	ДанныеЗаписи = РегистрыСведений.ОбъектыКЗагрузке.НовыйДанныеОбработкиОбъекта();
	ДанныеЗаписи.ПолученныйОбъект = ВыборкаДанныхДляОбработки.ПолученныйОбъект;
	ДанныеЗаписи.ОбъектФормата = ВыборкаДанныхДляОбработки.ОбъектФормата;
	ДанныеЗаписи.ПравилоКонвертации = ИмяПКО;
	ДанныеЗаписи.УзелПланаОбмена = ВыборкаДанныхДляОбработки.УзелПланаОбмена;
	ДанныеЗаписи.ВнешняяСсылкаНаОбъект = ИсторияПримененияПКО.НавигационнаяСсылка;
