#Область СлужебныйПрограммныйИнтерфейс

#Область Конструкторы

Функция КонструкторИсторииКонвертацииДанных() Экспорт
	
	ИсторияКонвертацииДанных = Новый Структура;
	ИсторияКонвертацииДанных.Вставить("ТекстыОшибок", Новый Соответствие);
	
	ИсторияКонвертацииДанных.Вставить("ЕстьОшибкаСобытияПередКонвертацией", Ложь);
	
	Возврат ИсторияКонвертацииДанных;
	
КонецФункции

Функция КонструкторИсторииПримененияПКО() Экспорт
	
	ИсторияПримененияПКО = Новый Структура;
	ИсторияПримененияПКО.Вставить("ВнешняяСсылкаСтрокой", "");
	ИсторияПримененияПКО.Вставить("НавигационнаяСсылка", "");
	ИсторияПримененияПКО.Вставить("ДанныеИБСсылка", Неопределено);
	ИсторияПримененияПКО.Вставить("ПравилоКонвертации", Неопределено); // ПКО - СтрокаТаблицыЗначений
	ИсторияПримененияПКО.Вставить("ПолученныеДанныеJSON", Неопределено);
	
	// В процессе конвертации для ошибок и предупреждений используем:
	// - признак с типом булево (отмечаем наличие проблемы);
	// - текстовое описание проблемы, как правило, стек. Вложено в соответствие "ТекстыОшибокПКО".
	//
	// Наименование свойства с текст описанием отличается от признака (булево) только префиксом "Есть". 
	// Например:
	// ЕстьОшибкаОпределенияПКО (булево), а его описание храним в ТекстыОшибокПКО["ОшибкаОпределенияПКО"]
	//
	ИсторияПримененияПКО.Вставить("ТекстыОшибокПКО", Новый Соответствие);
	
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаКонвертацииСтруктурыXDTO", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаОпределенияПКО", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаПоддерживаемыхОбъектовXDTO", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаСобытияПередЗаписьюПолученныхДанных", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаСобытияПриОбработкеСсылокБлокирующихКонвертацию", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаСобытияПослеКонвертацииОбъекта", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьОшибкаОбработкиУдаленияОбъекта", Ложь);
	
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеИзмененияНеразделенныхДанных", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеОбъектнойБлокировкиОбъекта", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеУстановитьВручнуюСоответствие", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеБлокировкиОбъектаДругимиОбъектами", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеПриПроведении", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеПриЗаписи", Ложь);
	ИсторияПримененияПКО.Вставить("ЕстьПредупреждениеПриСохранении", Ложь);
	
	ИсторияПримененияПКО.Вставить("ЕстьИнформированиеОтказаОтКонвертацииОбъекта", Ложь); // Информирование не считаем ошибкой
	
	ИсторияПримененияПКО.Вставить("ДобавленоНовоеСоответствиеПИСО", Ложь);
	ИсторияПримененияПКО.Вставить("ЕслиНетСоответствияИскатьПоКлючам", Истина);
	ИсторияПримененияПКО.Вставить("ЕслиНетСоответствияСоздаватьНовый", Истина);
	ИсторияПримененияПКО.Вставить("ЕслиНетСоответствияУстанавливатьВручную", Ложь);
	ИсторияПримененияПКО.Вставить("ЗагрузкаДанныхТребуетПодтверждения", Ложь);
	ИсторияПримененияПКО.Вставить("ИгнорироватьПроблемыПриЗаписи", Ложь); // Булево - ИСТИНА разрешает конвертации ухудшать состояние объектов ИБ
	
	ИсторияПримененияПКО.Вставить("СтратегияЗаписиОбъекта", ""); // Строка - разрешенные действия: проведение, запись, сохранение
	ИсторияПримененияПКО.Вставить("СтратегияПоискаПоКлючам", КонвертацияОбъектноСервер.ИдентификаторСтандартнойСтратегииПоискаПоКлючам());
	ИсторияПримененияПКО.Вставить("СтратегияПоискаПоКлючамГраница", Неопределено);
	ИсторияПримененияПКО.Вставить("СвойстваУспешнойКонвертации", Новый Соответствие);	// Каждый элемент соответствует шапке или ТЧ объекта.
																						// Значением элемента является строка с именами реквизитов, которые успешно прочитаны.
	ИсторияПримененияПКО.Вставить("СвойстваИсключенныеИзКонвертации", Новый Соответствие);	// Каждый элемент соответствует шапке или ТЧ объекта.
																							// Значением элемента является строка с именами реквизитов, которые не конвертировались.
	ИсторияПримененияПКО.Вставить("СсылкиБлокирующиеКонвертацию", Новый Массив); // Массив из Структура, см. КонвертацияОбъектноСервер.КонструкторСсылкиБлокирующиеКонвертацию()
	ИсторияПримененияПКО.Вставить("ЭтоНовыйОбъект", Неопределено);
	
	Возврат ИсторияПримененияПКО;
	
КонецФункции

Функция КонструкторИсторииПримененияПОД() Экспорт
	
	// Свойства:
	// - "ЕстьОшибкаОбработкиЗапросаВыгрузкиОбъекта" 
	// относиться к конвертации объекта, т.е. не к выполнению ПКО, т.к. это отдельные ветки конвертации.
	
	ИсторияКонвертацииОбъекта = Новый Структура;
	ИсторияКонвертацииОбъекта.Вставить("ЗначениеТипОбъектаXDTO", Неопределено);
	ИсторияКонвертацииОбъекта.Вставить("ЗначениеОбъектXDTO", Неопределено);
	ИсторияКонвертацииОбъекта.Вставить("ЗначениеПОД", Неопределено);
	ИсторияКонвертацииОбъекта.Вставить("ПолученныйОбъект", Неопределено);
	ИсторияКонвертацииОбъекта.Вставить("ОбъектФормата", Неопределено);
	ИсторияКонвертацииОбъекта.Вставить("УказанноеИмяПКО", Неопределено); // Используется при интерактивной работе
	
	ИсторияКонвертацииОбъекта.Вставить("ТекстыОшибокПОД", Новый Соответствие);
	
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаОпределенияТипаОбъектаXDTO", Ложь);
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаДесериализацииПоТипуXDTO", Ложь);
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаОбработкиЗапросаВыгрузкиОбъекта", Ложь);
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаОпределенияПОД", Ложь);
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаСобытияПриОбработкеПОД", Ложь);
	ИсторияКонвертацииОбъекта.Вставить("ЕстьОшибкаНепредвиденногоИсключения", Ложь);
	
	Возврат ИсторияКонвертацииОбъекта;
	
КонецФункции

Функция КлючЭлементаСоответствияСвойствШапки() Экспорт
	
	// См. КонструкторИсторииПримененияПКО(), СвойстваУспешнойКонвертации и СвойстваИсключенныеИзКонвертации.
	Возврат "Шапка";
	
КонецФункции

#КонецОбласти

#Область ФиксацияОшибок

Процедура ФиксироватьНеобходимостьПодтвержденияЗагрузкиДанных(КомпонентыОбмена, ПолученныеДанные, ЭтоУдаление = Ложь) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	Если ЭтоУдаление = Истина Тогда
		
		ШаблонТекста = НСтр("ru ='Удаление объекта %1 не выполнено,
			|т.к. установлена настройка, которая требует подтверждения от пользователя.'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	Иначе
		
		ШаблонТекста = НСтр("ru ='Загрузка объекта %1 не выполнена,
			|т.к. установлена настройка, которая требует подтверждения от пользователя.'", ОбщегоНазначения.КодОсновногоЯзыка());
		
	КонецЕсли;
	
	ПредставлениеОбъекта = КонвертацияОбъектноРецепцияСервер.ПредставлениеОбъектаДляПротокола(ПолученныеДанные);
	ТекстОшибки = СтрШаблон(ШаблонТекста, ПредставлениеОбъекта);
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеНеобходимостиПодтвердитьЗагрузкуДанных"] = ТекстОшибки;
	
КонецПроцедуры

Процедура ФиксироватьНеобходимостьРучнойЗагрузкиДанныхЧерезСопоставление(КомпонентыОбмена, ВнешняяСсылкаСтрокой) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьПредупреждениеУстановитьВручнуюСоответствие = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ОбъектМетаданных = ИдентификаторОбъектаМетаданныхИзПравилаКонвертации(КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ПравилоКонвертации);
	
	ШаблонТекста = НСтр("ru ='В настройках синхронизации установлена опция запрещающая добавление данных этого типа %1 в автоматическом режиме.
		|Необходимо выполнить сопоставления в ручном режиме, предварительно, при необходимости, создать новые объект.'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ТекстОшибки = СтрШаблон(ШаблонТекста, ОбъектМетаданных);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ПредупреждениеУстановитьВручнуюСоответствие"] = ТекстОшибки;
	
КонецПроцедуры

Процедура ФиксироватьОшибкуДесериализацииПоТипуXDTO(КомпонентыОбмена, ТипОбъектаXDTO, СодержимоеЗаписи, ТекстОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияКонвертацииОбъекта.ЕстьОшибкаДесериализацииПоТипуXDTO = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонОписанияОшибки = НСтр("ru = 'Формат полученных данных к загрузке не соответствуют ожидаемому.
		|
		|Направление: %1
		|Тип формата: %2
		|Данные XML:
		|%3
		|
		|Для устранения проблемы обратитесь к администратору.
		|
		|Описание для разработчика:
		|%4'");
	
	НаправлениеОбмена = КомпонентыОбмена.НаправлениеОбмена;
	
	ОписаниеОшибки = СтрШаблон(ШаблонОписанияОшибки, НаправлениеОбмена, ТипОбъектаXDTO, СодержимоеЗаписи, ТекстОшибки);
	
	КомпонентыОбмена.ИсторияКонвертацииОбъекта.ТекстыОшибокПОД.Вставить("ОшибкаДесериализацииПоТипуXDTO", ОписаниеОшибки);
	
КонецПроцедуры

Процедура ФиксироватьОшибкуИсполненияПКС(КомпонентыОбмена, ПКС, Знач ОписаниеОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекстаОшибки = НСтр("ru = 'При выполнении конвертации свойства структуры объекта XDTO <%1> в свойство конфигурации <%2> возникла ошибка:
		|%3'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	СвойствоФормата = ПКС.СвойствоФормата;
	СвойствоКонфигурации = ПКС.СвойствоКонфигурации;
	
	ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, СвойствоФормата, СвойствоКонфигурации, ОписаниеОшибки);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ОшибкаКонвертацииСвойстваСтруктурыXDTO"] = ТекстОшибки;
	
	// Запись в протокол для ошибок конвертации свойств сделаем в ФиксироватьОшибкуКонвертацииСтруктурыОбъектаПоПКО()
	
КонецПроцедуры

Процедура ФиксироватьОшибкуКонвертацииСтруктурыОбъектаПоПКО(КомпонентыОбмена, Знач ОписаниеЭтапа, Знач ПредставлениеОбъекта, Знач ОписаниеОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьОшибкаКонвертацииСтруктурыXDTO = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонТекстаОшибки = НСтр("ru ='Конвертация структуры зачитанных данных объекта XDTO в объект информационной базы завершилась ошибкой.
	|	
	|	ПОД: %1
	|	ПКО: %2
	|	Этап: %3
	|	Объект: %4
	|
	|Для устранения проблемы обратитесь к администратору.
	|
	|Описание для разработчика:
	|%5'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	ИмяПОД = КомпонентыОбмена.ИсторияКонвертацииОбъекта.ЗначениеПОД.Имя;
	ИмяПКО = КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ПравилоКонвертации.ИмяПКО;
	
	// Если пришли сюда из-за ошибки конвертации свойства, то уже есть подробности исключений
	Если КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ЕстьОшибкаКонвертацииСвойстваСтруктурыXDTO = Истина Тогда
		
		ОписаниеОшибки = КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ОшибкаКонвертацииСвойстваСтруктурыXDTO"];
		
	КонецЕсли;
	
	ТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, ИмяПОД, ИмяПКО, ОписаниеЭтапа, ПредставлениеОбъекта, ОписаниеОшибки);
	КомпонентыОбмена.ИсторияПримененияТекущегоПКО.ТекстыОшибокПКО["ОшибкаКонвертацииСтруктурыXDTO"] = ТекстОшибки;
	
	КонвертацияОбъектноРецепцияСервер.ЗаписатьВПротоколВыполнения(КомпонентыОбмена, ТекстОшибки, , Ложь);
	
КонецПроцедуры

Процедура ФиксироватьОшибкуОбработкиЗапросаВыгрузкиОбъекта(КомпонентыОбмена, ПравилоКонвертации, ОписаниеСсылкиЗапроса, ПодобраннаяОбъектнаяСсылка, ОписаниеОшибки) Экспорт
	
	КомпонентыОбмена.ИсторияКонвертацииОбъекта.ЕстьОшибкаОбработкиЗапросаВыгрузкиОбъекта = Истина;
	ОтметитьНаличиеПредупреждения(КомпонентыОбмена);
	
	ШаблонОписанияОшибки = НСтр("ru = 'Приложение корреспондент попросило повторно выгрузить данные, но обработка запроса завершилась с ошибкой.
			|
			|Обработчик: %1
			|Описание данных для поиска: %2
			|Идентификатор поиска: %3
			|Навигационная ссылка: %4
			|Подобранная объектная ссылка: %5
			|
			|Описание для разработчика:
			|%6.'");
	
	ИмяОбработчика = "ПриПолученииЗапросаВыгрузкиОбъекта";
	
	ПредставлениеНайденногоОбъекта = "";
	Если ПодобраннаяОбъектнаяСсылка <> Неопределено Тогда
		
		ПредставлениеНайденногоОбъекта = КонвертацияОбъектноРецепцияСервер.ПредставлениеОбъектаДляПротокола(ПодобраннаяОбъектнаяСсылка);
		
	КонецЕсли;
	
	ТаблицаДанных = ПравилоКонвертации.ПолноеИмя;
	ИдентификаторДляПоиска = ОписаниеСсылкиЗапроса.БлокирующийИдентификатор;
	НавигационнаяСсылка = СокрЛП(ОписаниеСсылкиЗапроса.ВнешняяНавигационнаяСсылка);
	
	ТекстОшибки = СтрШаблон(ШаблонОписанияОшибки, ИмяОбработчика, ТаблицаДанных, ИдентификаторДляПоиска, НавигационнаяСсылка,
		ПредставлениеНайденногоОбъекта, ОписаниеОшибки);
	
	ТекущаяЗапись = СокрЛП(КомпонентыОбмена.ИсторияКонвертацииОбъекта.ТекстыОшибокПОД["ОшибкаОбработкиЗапросаВыгрузкиОбъекта"]);
	Если НЕ ПустаяСтрока(ТекущаяЗапись) Тогда
		
		ТекущаяЗапись = ТекущаяЗапись + Символы.ПС + Символы.ПС;
		
	КонецЕсли;
	
	КомпонентыОбмена.ИсторияКонвертацииОбъекта.ТекстыОшибокПОД["ОшибкаОбработкиЗапросаВыгрузкиОбъекта"] = ТекущаяЗапись + ТекстОшибки;
	
